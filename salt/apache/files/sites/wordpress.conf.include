DocumentRoot /home/{{ user }}/public_html
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header set X-Content-Type-Options nosniff

<Directory /home/{{ user }}/public_html>
    Require all granted
    Options FollowSymLinks
    AllowOverride Limit Options FileInfo {{ extra_overrides | default([]) | join(' ') }}
    DirectoryIndex index.php
</Directory>

<FilesMatch "\.php$">
    SetHandler "proxy:unix:{{ socket }}|fcgi://localhost/"
</FilesMatch>

<FilesMatch "^wp-login\.php$">
    AuthType Basic
    AuthName "Restricted Area"
    AuthUserFile /etc/apache2/.htpasswd-{{ user }}
    Require valid-user
</FilesMatch>

<FilesMatch "^xmlrpc\.php$">
    Require all denied
</FilesMatch>

# Our sites need no direct HTTP access to plugin/theme PHP files.
<DirectoryMatch "^/home/{{ user }}/public_html/wp-content/(?:uploads|plugins|themes)/">
    <FilesMatch "\.(?:php[1-7]?|pht|phtml?|phps)\.?$">
        Require all denied
    </FilesMatch>
</DirectoryMatch>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

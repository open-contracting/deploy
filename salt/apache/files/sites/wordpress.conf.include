DocumentRoot /home/{{ user }}/public_html
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header set X-Content-Type-Options nosniff

<Directory /home/{{ user }}/public_html>
    Require all granted
    Options FollowSymLinks
    AllowOverride Limit Options FileInfo AuthConfig
    DirectoryIndex index.php
</Directory>

# Only the document root's .htaccess needs FileInfo, whose SetHandler can route any extension to PHP-FPM.
<Directory /home/{{ user }}/public_html/wp-content>
    AllowOverride Limit Options AuthConfig
</Directory>

<FilesMatch "\.php$">
    SetHandler "proxy:unix:{{ socket }}|fcgi://localhost/"
</FilesMatch>

# An inline body, so a 503 from Apache (e.g. PHP-FPM unreachable) is distinguishable by size in the access log.
ErrorDocument 503 "Service Unavailable"

<Files "wp-login.php">
    AuthType Basic
    AuthName "Restricted Area"
    AuthUserFile /etc/apache2/.htpasswd-{{ user }}
    Require valid-user
</Files>

# Paths inside dot-directories (.git/HEAD), except ACME's.
<DirectoryMatch "/\.(?!well-known(/|$))">
    Require all denied
</DirectoryMatch>
# Dotfiles and .env environment files (Apache's covers .ht* only).
<FilesMatch "^\.|\.env$">
    Require all denied
</FilesMatch>

<Files "wp-config.php">
    Require all denied
</Files>
<Files "xmlrpc.php">
    Require all denied
</Files>

# Core's PHP entry points are all at the root (index.php, wp-login.php, wp-cron.php, ...).
<DirectoryMatch "^/home/{{ user }}/public_html/wp-includes/">
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    # The one file under wp-includes that browsers request.
    <Files "wp-tinymce.php">
        Require all granted
    </Files>
</DirectoryMatch>
<DirectoryMatch "^/home/{{ user }}/public_html/wp-admin/includes/">
    Require all denied
</DirectoryMatch>
<DirectoryMatch "^/home/{{ user }}/public_html/wp-admin/">
    <Files "install.php">
        Require all denied
    </Files>
</DirectoryMatch>

# Our sites need no direct HTTP access to plugin/theme PHP files.
<DirectoryMatch "^/home/{{ user }}/public_html/wp-content/(?:uploads|plugins|themes)/">
    <FilesMatch "\.(?:php[1-7]?|pht|phtml?|phps)\.?$">
        Require all denied
    </FilesMatch>
</DirectoryMatch>

# Handle missing static assets, instead of routing to index.php.
RewriteEngine On
# uploads/ is exempt: media filenames can be UTF-8 on disk but percent-encoded in the URL, and
# %{REQUEST_URI} is not reliably decoded before mapping, so -f could 404 a file that exists.
RewriteCond %{REQUEST_URI} !^/wp-content/uploads/
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
# Cloudflare's list, plus `map` and `webmanifest`, minus `ico` (WordPress serves favicon.ico).
# https://developers.cloudflare.com/cache/concepts/default-cache-behavior/#default-cached-file-extensions
RewriteRule \.(?:7z|apk|avi|avif|bin|bmp|bz2|class|css|csv|dmg|doc|docx|ejs|eot|eps|exe|flac|gif|gz|iso|jar|jpeg|jpg|js|map|mid|midi|mkv|mp3|mp4|ogg|otf|pdf|pict|pls|png|ppt|pptx|ps|rar|svg|svgz|swf|tar|tif|tiff|ttf|webm|webp|webmanifest|woff|woff2|xls|xlsx|zip|zst)$ - [R=404,L]

# Handle scanners' probes, which WordPress would answer with its full 404 page. WordPress has no
# pages or endpoints at any path this rule matches, so the rule blocks nothing WordPress serves.
#
# Each alternative, compared to OWASP CRS (https://github.com/coreruleset/coreruleset):
# - Missing files under wp-content/plugins/ and wp-content/themes/, mostly from plugins and
#   themes we don't run. WordPress-specific, so not in CRS.
# - Extensions from CRS's restricted_extensions (set in rules/REQUEST-901-INITIALIZATION.conf,
#   used by rule 920440) that scanners request per our access logs, plus `php` (WordPress's PHP
#   entry points exist on disk).
# - Hidden paths (except .well-known/), wp-config backups, and the `env`, `toml`, `yaml` and `yml`
#   extensions. CRS's rules/restricted-files.data (rule 930130) lists the wp-config backups, and
#   some hidden paths and files with those extensions, which this rule extends to all of them.
#
#   The <DirectoryMatch> and <FilesMatch> above miss hidden paths if a parent directory doesn't
#   exist: Apache tests the path only up to the first missing part (like `/app` in `/app/.env`).
# - A dot double-encoded as `%252e` (decoded once, to `%2e`), used to access parent or hidden
#   paths on servers that decode twice (rule 930100). Apache decodes once.
# - A path segment that starts with `;`, like `/;.env.sample`, that scanners request per our
#   access logs. Apache gives `;` no meaning. Not in CRS.
RewriteCond %{REQUEST_URI} !^/wp-content/uploads/
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteRule ^/wp-content/(?:plugins|themes)/|\.(?:bak|cfg|conf|ini|log|old|save|sql|swp|php|env|toml|ya?ml)$|/\.(?!well-known(?:/|$))|wp-config[._-]|%2e|/; - [R=404,L,NC]

<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

RequestHeader unset X-Forwarded-Proto
RequestHeader set X-Forwarded-Proto https env=HTTPS

# https://docs.djangoproject.com/en/stable/howto/deployment/wsgi/modwsgi/#serving-files
{%-
    for path, url in (
        ('/favicon.ico', '/static/favicon.ico'),
        ('/robots.txt', '/static/robots.txt'),
        ('/media/', '/media/'),
        ('/static/', '/static/'),
    )
%}
ProxyPass {{ path }} http://127.0.0.1:{{ static_port }}{{ url }} timeout=10
ProxyPassReverse {{ path }} http://127.0.0.1:{{ static_port }}{{ url }}
{%- endfor %}

ProxyPass / http://127.0.0.1:{{ port }}/{% if timeout is defined %} timeout={{ timeout }}{% endif %}
ProxyPassReverse / http://127.0.0.1:{{ port }}/

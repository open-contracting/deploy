RequestHeader unset X-Forwarded-Proto
RequestHeader set X-Forwarded-Proto https env=HTTPS

<Proxy *>
{%- if authname is defined %}
    AuthName "{{ authname }}"
    AuthType Basic
    AuthUserFile /etc/apache2/.htpasswd-{{ name }}
    Require valid-user
{% endif %}
    RewriteEngine on
    RewriteRule .* - [E=PROXY_USER:%{LA-U:REMOTE_USER},NS]
    RequestHeader set X-WEBAUTH-USER "%{PROXY_USER}e"
</Proxy>

RequestHeader unset Authorization

ProxyRequests off
ProxyPreserveHost on
{%- if authname is defined %}
# Safari requests these outside the page's credential context, so a challenge here prompts for a password.
ProxyPassMatch ^/(favicon\.ico|apple-touch-icon(-[0-9]+x[0-9]+)?(-precomposed)?\.png)$ !
RedirectMatch 404 ^/(favicon\.ico|apple-touch-icon(-[0-9]+x[0-9]+)?(-precomposed)?\.png)$
{%- endif %}
ProxyPass /api/live/ws {{ proxypass|replace("http", "ws") }}api/live/ws upgrade=websocket timeout=300
ProxyPass / {{ proxypass }}
ProxyPassReverse / {{ proxypass }}
